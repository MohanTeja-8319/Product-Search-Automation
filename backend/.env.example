PORT=5000
MONGODB_URI=mongodb+srv://<username>:<password>@cluster0.mongodb.net
DB_NAME=product_search_automation
JWT_SECRET=your_jwt_secret_key_here
JWT_EXPIRES_IN=7d
CLIENT_ORIGIN=http://localhost:5173

# Email Notifications (SMTP / Gmail App Password)
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USER=your_email@gmail.com
EMAIL_PASS=your_app_password
EMAIL_FROM="Product Search Automation <your_email@gmail.com>"
RESET_TOKEN_EXPIRES_IN=10m

# QuickCommerce API (https://api.quickcommerceapi.com)
QUICKCOMMERCE_API_KEY=your_quickcommerce_api_key_here
SEARCH_LAT=12.9021
SEARCH_LON=77.6639
SEARCH_PINCODE=

# Web Push Notifications (Generate with: npx web-push generate-vapid-keys)
VAPID_PUBLIC_KEY=your_vapid_public_key
VAPID_PRIVATE_KEY=your_vapid_private_key
VAPID_SUBJECT=mailto:alerts@productsearch.local

# Background Price Alert Interval (ms)
ALERT_CHECK_INTERVAL_MS=900000
