PORT=5000
MONGODB_URI=YOUR_MONGODB_CONNECTION_STRING
DB_NAME=YOUR_DATABASE_NAME
JWT_SECRET=YOUR_JWT_SECRET
JWT_EXPIRES_IN=7d
CLIENT_ORIGIN=http://localhost:5173
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USER=YOUR_GMAIL_ADDRESS
EMAIL_PASS=YOUR_GMAIL_APP_PASSWORD
EMAIL_FROM=YOUR_GMAIL_ADDRESS

# ── QuickCommerce API ─────────────────────────────────────────
QUICKCOMMERCE_API_KEY=YOUR_QUICKCOMMERCE_API_KEY

SEARCH_LAT=12.9021
SEARCH_LON=77.6639
SEARCH_PINCODE=

# ── Cache & Rate-Limit Protection ────────────────────────────
# How long (ms) a successful API response is cached server-side.
# Default: 3600000 (60 minutes). Increase to save more credits.
SEARCH_CACHE_TTL_MS=3600000

# How long (ms) the circuit breaker locks into mock mode after
# a 429 / EOF error. Default: 300000 (5 minutes).
CIRCUIT_BREAKER_COOLDOWN_MS=300000

# ── Alert Monitor ─────────────────────────────────────────────
ALERT_CHECK_INTERVAL_MS=900000

# ── Web Push (VAPID) ─────────────────────────────────────────
VAPID_PUBLIC_KEY=YOUR_VAPID_PUBLIC_KEY
VAPID_PRIVATE_KEY=YOUR_VAPID_PRIVATE_KEY
VAPID_SUBJECT=mailto:YOUR_GMAIL_ADDRESS
