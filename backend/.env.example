PORT=5000
MONGODB_URI="your-mongodb-connection-string"
DB_NAME=product_search_automation
JWT_SECRET="replace-with-a-long-random-string"
JWT_EXPIRES_IN=7d
CLIENT_ORIGIN=http://localhost:5173

# QuickCommerce API (keep this secret; do not put it in frontend/.env)
QUICKCOMMERCE_API_KEY=replace-with-your-quickcommerce-api-key
# Default location used because the QuickCommerce search endpoint requires lat/lon.
SEARCH_LAT=12.9021
SEARCH_LON=77.6639
SEARCH_PINCODE=
